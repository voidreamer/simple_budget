# Copy to .env on the server and fill in real values. Never commit .env.

# Supabase Postgres connection string (unchanged from the Lambda setup)
DATABASE_URL=postgresql://user:password@db.xxxxxxxx.supabase.co:5432/postgres

# Supabase JWT secret (Project Settings -> API -> JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Domain pointing at the Oracle server; Caddy provisions HTTPS for it automatically.
# Leave unset to serve plain HTTP on port 80 while testing.
DOMAIN=budget.example.com

# Comma-separated origins allowed by CORS. Only needed for local dev or if the
# UI is hosted on a different origin than the API; when Caddy serves both, the
# app is same-origin and CORS never triggers.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
